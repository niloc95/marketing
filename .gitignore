#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#-------------------------
# Environment Files
#-------------------------
# These should never be under version control,
# as it poses a security risk.
#
# Glob, not the bare `.env`: a literal pattern silently let `.env_old`,
# `.env.production`, `.env.bak` and friends through, and a real production
# .env once ended up staged that way. Only the scrubbed placeholder template
# is exempted back in.
.env*
!.env.production.example
.vagrant
Vagrantfile

# The bare-name copies the glob above cannot see. `deploy/env` is a working copy
# of a filled-in environment — live DB, SMTP, PayFast and admin credentials —
# and this repo is PUBLIC. The tracked root `env` is the scrubbed CI4 template
# (every secret line commented out) and stays tracked; this one must not.
/deploy/env

# Secrets for marketing-site/contact.php. Unanchored on purpose: it covers the
# repo root (docroot of `npm run site:serve`) and dist/ (docroot of
# `npm run site:preview`). marketing-site/.env.example is the committed
# template; the live copy belongs ABOVE the docroot — see DEPLOY.md §6.
.ws-contact.env

#-------------------------
# Temporary Files
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

# Verification documents: company registration certificates and owner ID
# copies. PII — never in the repo, never under public/.
/writable/verification/*
!/writable/verification/index.html

php_errors.log

#-------------------------
# User Guide Temp Files
#-------------------------
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# Test Files
#-------------------------
/tests/coverage*

# Don't save phpunit under version control.
/phpunit

#-------------------------
# Composer
#-------------------------
vendor/

# ...but NOT the vendored front-end libraries. The rule above is unanchored, so
# it swallows public/assets/vendor/ too — and because the pin picker no-ops
# silently when Leaflet is absent, a fresh clone would build a deploy bundle
# with a quietly missing map instead of an obvious error.
!/public/assets/vendor/

#-------------------------
# Runtime-uploaded listing media (not source — logos/gallery photos
# uploaded through the app; the upload code recreates this directory
# on demand via mkdir)
#-------------------------
/public/assets/listings/*

#-------------------------
# Runtime-uploaded hero photographs, from admin/hero.
#
# Only the uploads/ subdirectory. public/assets/hero/ itself holds the seeded
# photographs, which ARE source: they are what a fresh install's home page
# shows, they are referenced by DirectoryHeroImagesSeeder, and they ship in the
# deploy bundle. Uploads are per-environment content and must not — a
# developer's test photo overwriting production's is exactly the failure the
# listings rule above exists to prevent.
#-------------------------
/public/assets/hero/uploads/*
!/public/assets/hero/uploads/.gitkeep

#-------------------------
# Claude Code local state
#-------------------------
# Local state only — machine-specific settings and lock files. The skills under
# .claude/skills/ are project documentation (the release runbook lives there), so
# they are tracked deliberately: a runbook that does not survive a fresh clone is
# not documentation.
.claude/*
!.claude/skills/
.claude/settings.local.json
.claude/scheduled_tasks.lock

#-------------------------
# IDE / Development Files
#-------------------------

# Modules Testing
_modules/*

# phpenv local config
.php-version

