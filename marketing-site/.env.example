#-----------------------------------------------------------------------------
# marketing-site/contact.php — configuration template
#-----------------------------------------------------------------------------
# This file is a TEMPLATE and is committed. The live copy is never committed and
# never deployed.
#
# PRODUCTION: copy it by hand to ONE LEVEL ABOVE the docroot, as
#
#     /home/<cpuser>/.ws-contact.env          (chmod 600)
#
# with contact.php living at /home/<cpuser>/public_html/contact.php. Above the
# docroot means no webserver can ever serve it as text, no FTP sync can ever
# delete it, and it needs no .htaccess to protect it. Do NOT put it in
# public_html — see DEPLOY.md §6.
#
# Note it starts with a dot. hPanel's file manager and FileZilla both hide
# dotfiles by default; turn that off or you will "upload" it into thin air.
#
# LOCAL: `npm run site:serve` serves marketing-site/ as the docroot, so ../ is
# the repo root — put it at ./.ws-contact.env there. `npm run site:preview`
# serves dist/site/, so its copy goes at ./dist/.ws-contact.env. Both names are
# git-ignored. WS_CONTACT_ENV overrides the search if you want it elsewhere.
#-----------------------------------------------------------------------------

# Where demo requests land. This inbox receives everything the form sends.
CONTACT_TO = 'za_admin@webscheduler.co.za'

# The From: address. MUST be a mailbox on a domain we control — putting the
# visitor's address here fails SPF/DMARC at the receiving end and the mail is
# binned. The visitor goes in Reply-To, which contact.php sets automatically.
CONTACT_FROM = 'no-reply@webscheduler.co.za'
CONTACT_FROM_NAME = 'WebScheduler website'

# HMAC key for the form token, which proves a POST followed a real page render.
# Generate once with:  php -r "echo bin2hex(random_bytes(32));"
# Rotating it invalidates tokens in open tabs; those visitors get the confirm
# step instead of a silent failure, so rotation is safe.
CONTACT_SECRET = CHANGE_ME_RANDOM_HEX

#-----------------------------------------------------------------------------
# SMTP — the cPanel mailbox that does the sending
#-----------------------------------------------------------------------------
SMTP_HOST = 'mail.webscheduler.co.za'
SMTP_PORT = 465
SMTP_USER = 'no-reply@webscheduler.co.za'
SMTP_PASS = 'CHANGE_ME'
SMTP_CRYPTO = 'ssl'

# Local development against Mailpit (`npm run mail:dev`) — no auth, no TLS.
# SMTP_HOST = localhost
# SMTP_PORT = 1025
# SMTP_USER =
# SMTP_PASS =
# SMTP_CRYPTO =

#-----------------------------------------------------------------------------
# Rate-limit counters. Also outside the docroot; create it once with
#   mkdir -m 700 /home/<cpuser>/ws-contact-state
# Leave it unset and contact.php falls back to the system temp directory, which
# on shared hosting may be swept or per-request — the limiter then quietly does
# nothing. It logs the fallback, but set this properly.
#-----------------------------------------------------------------------------
RATE_LIMIT_DIR = '/home/CPUSER/ws-contact-state'
