# =============================================================================
# WebScheduler scheduled jobs.
#
# Install:  /etc/cron.d/webscheduler   (root:root, chmod 644, MUST end with a
#           newline and MUST NOT be executable — cron ignores it otherwise)
#
# Note the extra user column: /etc/cron.d entries take one, unlike `crontab -e`.
# =============================================================================

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# --- Verification badge sweep -------------------------------------------------
# Expires verification badges that have passed their date. Explicitly NOT
# correctness-load-bearing: badge visibility is a render-time date comparison,
# so a missed run shows a stale badge until the next sweep rather than breaking
# anything. Same job, same time as it ran on Hostinger.
0 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:verifications:sweep --quiet

# --- Listing quality sweep ----------------------------------------------------
# Recomputes the profile-completeness score that orders search results.
# Unlike the verification sweep above, this one IS load-bearing: scores are
# written at six controller choke points, and the day somebody adds a seventh
# and forgets to call recalculate(), this is the only thing that repairs it.
# A stale score misorders results rather than breaking them, which is only
# acceptable because this runs nightly. --stale limits it to rows never scored
# or edited since their last score.
15 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:quality:recalculate --stale --quiet

# --- Description hints ------------------------------------------------------
# Rebuilds the "Others in Dentist often mention" hints under the description
# field from the day's published listings. After the quality sweep, because
# the word pairs come from listings at the quality target. Not load-bearing:
# a missed run leaves the hints a day older, and a cold cache is mined on the
# first request.
20 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:insights:build --quiet

# --- Discovery model -----------------------------------------------------------
# Relearns, per site, which categories a word is typical of ("cancer" ->
# Oncologist), related words that widen a search, the vocabulary for spelling,
# and what opened results taught it; purges Discover searches older than 180
# days (the privacy policy promises it). Not load-bearing: a missed run leaves
# the model a day older, but the purge must keep running.
25 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark discovery:learn --quiet

# --- Profile-strength nudge ---------------------------------------------------
# One email per profile, ever: a few days after going live, owners still under
# Config\Directory::$qualityTarget get the top things to fill in, with a sign-in
# button. Morning rather than 3am so it lands when people read mail; it re-scores
# each profile just before sending, so it does not need to follow the sweep.
# Not load-bearing — a missed run is caught the next day (fortnight window).
0 7 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:quality:nudge --quiet

# --- Public holiday hours -----------------------------------------------------
# Rolls each profile's holiday open dates forward (the "open today" search
# filter on a holiday), then, in the ten days before a public holiday, emails
# opted-in owners who have not said what they do on holidays. At most once
# every 90 days per owner. Morning, like the nudge, so it is read. A missed run
# costs one day of reminders and nothing else.
5 7 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:holidays:remind --quiet

# --- Jobs board housekeeping --------------------------------------------------
# Renew reminders, expiry, deleting posts never confirmed, and wiping poster
# contact details 12 months after a post ends (POPIA retention). Like the badge
# sweep, not correctness-load-bearing for visitors: the pages check the
# closing date themselves. It IS load-bearing for the retention promise in the
# privacy policy, so keep it installed.
30 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark jobs:expire --quiet

# --- Profile statistics retention ---------------------------------------------
# Deletes daily profile totals (views, appearances, contact taps) older than
# 25 months. Load-bearing for the retention promise in the privacy policy.
40 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:stats --quiet

# --- Recommend-a-business retention -------------------------------------------
# Wipes business and referrer contact details from referrals 12 months after
# submission, or 30 days after dismissal. Load-bearing for the retention
# promise in the privacy policy, like jobs:expire.
45 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark referrals:prune --quiet

# --- Partner Program ----------------------------------------------------------
# Moves partner commissions past their 30 day hold to "ready to pay", and
# rebuilds commission for any payment in the last week whose hook failed. Load
# bearing for what partners see as owed; a missed run only delays it a day.
50 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark partners:sweep --quiet

# --- Careers retention --------------------------------------------------------
# Deletes CVs and wipes applicant details 12 months after an application to
# /careers. Load-bearing for the retention promise on the form and in the
# privacy policy, like referrals:prune.
55 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark careers:purge --quiet

# Customer reviews: delete unconfirmed ones, wipe reviewer details from
# rejected/hidden ones after 30 days (POPIA), and email the admin one digest
# of the day's review reports.
0 4 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark reviews:prune --quiet

# Form health: yesterday's summary for every form to the admin (nothing on a
# quiet day), and form events older than 180 days deleted.
5 4 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark forms:digest --quiet

# --- Map pin retry -------------------------------------------------------------
# Weekly retry of listings whose address lookup failed at save time (a Mapbox
# outage or a bad token, like the 401s of Sep 2026) and of 'stale' pins kept
# from before a street-only edit. A kept pin is only replaced by a result at
# least as precise, and hand-placed pins are never touched. Capped at 100 rows,
# so even a bad week stays well inside one block of 1,000 Mapbox lookups. Not
# load-bearing: a profile with no pin is still listed and searchable by text.
10 4 * * 0 deploy cd /var/www/listing/directory-app && /usr/bin/php spark directory:geocode --status failed,stale --limit 100 > /dev/null

# --- Nightly database dump ----------------------------------------------------
# Replaces Hostinger's plan backups. Credentials come from /home/deploy/.my.cnf
# (chmod 600) so no password appears in the process list or in this file.
#
# --single-transaction keeps it non-blocking on InnoDB. Do NOT drop
# --default-character-set=utf8mb4: dumping as latin1 silently mangles accented
# practice names, and you only find out at restore time.
# --no-tablespaces: the deploy user has no PROCESS privilege (it does not need
# one), and without this mysqldump 8.0 writes an "Access denied ... when trying
# to dump tablespaces" error to stderr on every run. The dump itself is complete
# either way, but MAILTO="" swallows the noise — and would swallow a real
# failure just as quietly.
15 2 * * * deploy /usr/bin/mysqldump --defaults-file=/home/deploy/.my.cnf --single-transaction --default-character-set=utf8mb4 --routines --triggers --no-tablespaces webscheduler_directory | gzip > /home/deploy/backups/db-$(date +\%F).sql.gz

# Prune dumps older than 14 days. Lightsail's automatic snapshots are the real
# backup — these are for quick "restore one table" work without rolling an
# instance back.
30 2 * * * deploy find /home/deploy/backups -name 'db-*.sql.gz' -mtime +14 -delete

# --- Offsite copy --------------------------------------------------------------
# Last night's dump plus the uploaded files go to S3 in af-south-1, so a backup
# survives losing this box (the dumps above and the Lightsail snapshots do not
# leave AWS's Mumbai region). Keys for an upload only IAM user live in
# /home/deploy/.aws (700). The bucket expires objects after 30 days. Runs from
# the release clone; one OK or FAIL line per night in /home/deploy/backups/offsite.log.
40 2 * * * deploy BUCKET=webscheduler-local-backups-896680103616-af-south-1-an /home/deploy/src/scripts/backup-offsite.sh

# The script cannot report a night it never ran, and MAILTO is empty, so this
# reads its log half an hour later and emails the admin unless the last line
# is a recent OK (Libraries\OffsiteBackupCheck).
10 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark backups:check --quiet

# Monthly restore drill: the newest dump into webscheduler_restore_drill_tests
# (dropped afterwards; the webscheduler user needs ALL on that one name), every
# table compared with the live one, files-latest.tar.gz listed. The daily check
# mails the admin if no drill has passed in 32 days.
30 4 1 * * deploy /home/deploy/src/scripts/restore-drill.sh > /dev/null
12 3 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark backups:check --log /home/deploy/backups/restore-drill.log --max-age 768 --name "Restore drill" --quiet

# --- Certificate expiry warning ----------------------------------------------
# The Cloudflare origin certificate is valid for 15 years, so there is no renewal
# cron. That is precisely why it needs a reminder: nothing else will ever mention
# it again, and Full (strict) breaks hard the day it lapses.
0 9 1 * * deploy /usr/bin/openssl x509 -in /etc/ssl/cloudflare/webscheduler.co.za.pem -noout -checkend 7776000 || echo "Cloudflare origin cert for webscheduler.co.za expires within 90 days"

# --- Session files ------------------------------------------------------------
# CI4 keeps sessions as files in writable/session, and nothing else deletes
# them: Ubuntu sets session.gc_probability = 0 and its own phpsessionclean
# timer only clears /var/lib/php/sessions. 68,859 files (275 MB) had piled up
# by 4 Nov 2026. Sessions expire after 2 hours (Config\Session::$expiration),
# so a day old file is dead; current visitors are never touched.
20 4 * * * deploy find /var/www/listing/directory-app/writable/session -maxdepth 1 -type f -name 'ci_session*' -mmin +1440 -delete

# Online bookings (docs/bookings/, Phase 6): queue due reminders and send
# booking emails, SMS and WhatsApp, every minute for every business. Does
# nothing while bookings.enabled is off. A MySQL lock stops overlapping runs.
* * * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark bookings:dispatch --quiet

# Booking deposits (Phase 8): ask Paystack about payments left open and free
# times whose deposit was not paid in time. Nothing while bookings are off.
*/5 * * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark bookings:payments --quiet

# Booking delivery logs, finished queue rows and read notices older than 90 days.
35 4 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark bookings:prune --quiet

# The Bookings plan (Phase 10): trial reminders and missed Paystack renewals.
# Nothing while bookings.planRequired is off.
40 4 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark bookings:plans --quiet

# POPIA retention for booking customers (Phase 10, D12): personal details go
# 24 months after the last appointment. Nothing while bookings are off.
45 4 * * * deploy cd /var/www/listing/directory-app && /usr/bin/php spark bookings:retention --quiet
