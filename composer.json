{
    "name": "webscheduler/local",
    "description": "WebScheduler Local: the CodeIgniter 4 discovery and visibility app behind local.webscheduler.co.za",
    "license": "MIT",
    "type": "project",
    "homepage": "https://local.webscheduler.co.za",
    "require": {
        "php": "^8.2",
        "azuyalabs/yasumi": "^2.7",
        "codeigniter4/framework": "^4.7",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.30"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
