#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

# Config\Cookie::$secure defaults to (CI_ENVIRONMENT === 'production'), so you
# normally do not need this. Uncomment only as an escape hatch — e.g. a staging
# host without TLS, or a proxy that terminates HTTPS upstream (in which case also
# populate Config\App::$proxyIPs, or forcehttps will redirect-loop).
# cookie.secure = false

# cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# DIRECTORY (this app)
#--------------------------------------------------------------------

# directory.siteName = 'WebScheduler Directory'

# Where new-submission notifications are sent.
# directory.adminEmail =

# Password for /admin/login. Set a strong value in production.
# directory.adminPassword =

# Google Analytics 4 measurement ID. A real ID ships in app/Config/Directory.php,
# so leaving this commented out means analytics IS on. Set it to an empty string to
# turn analytics and the cookie banner off — do that on staging and local dev so
# they don't pollute the production property.
# directory.analyticsId = ''

# Maps are Leaflet on OpenStreetMap data (tiles below), and "near me" is a query
# against our own database, so neither is billed per request. Address LOOKUP is
# the one paid piece, and only when this token is set: Mapbox answers the form's
# typeahead (temporary requests, never stored) and the lookups whose coordinates
# are saved (permanent requests, which Mapbox's terms require for storage).
#
# Unset, lookups fall back to Nominatim with no typeahead, because the public
# Nominatim server's policy forbids autocomplete. Use a public (pk.) token with no
# URL restriction: it is only sent server to server, and a URL restriction is
# checked against a browser Referer that these requests don't carry.
# directory.mapboxToken = 'pk.CHANGE-ME'

# Tile source for every map in the app. Defaults to CARTO's Voyager
# raster basemap — the same OpenStreetMap data, served from a CDN built for
# embedding. Deliberately NOT tile.openstreetmap.org: those servers are
# donation-funded, their policy discourages commercial use, and a block shows up
# as a blank grey map with no warning.
#
# Alternative CARTO styles: swap "rastertiles/voyager" for "light_all" (Positron,
# very muted) or "dark_all". Other hosts with free tiers: MapTiler, Stadia,
# Thunderforest — all need only these two values changed, no code.
#
# Attribution is mandatory and must credit both the data (OpenStreetMap) and the
# tile host. Update it to match whatever provider you point at.
# directory.mapTileUrl = 'https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
# directory.mapTileAttribution = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

# Used for listing verification emails and admin notifications.
#
# These are LIVE (uncommented) on purpose: they point at Mailpit, so a fresh
# clone catches mail locally instead of silently doing nothing. Leaving them
# commented makes email.protocol fall back to PHP mail(), and because send
# failures are swallowed by design (see DirectoryListingMutationService::send)
# the verification email would vanish with no error.
#
# Start Mailpit with `npm run mail:dev`; inbox at http://localhost:8025.
# The production template is separate — dist/listing/directory-app/.env.example,
# generated by `npm run list:build` with CHANGE-ME placeholders.
email.protocol = smtp
email.SMTPHost = localhost
email.SMTPPort = 1025
email.SMTPCrypto =
email.fromEmail = 'no-reply@webscheduler.co.za'
email.fromName = 'WebScheduler Directory'
email.mailType = html

# Production only — real SMTP needs auth and TLS on 587:
# email.SMTPUser =
# email.SMTPPass =
# email.SMTPPort = 587
# email.SMTPCrypto = tls

