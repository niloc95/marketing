#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# REQUIRED for local development. CodeIgniter defaults this to 'production' when
# unset, and in production Config\Cookie::$secure is on — so serving over plain
# http:// without setting this below throws SecurityException::forInsecureCookie
# (a 500 on every request). Set 'development' locally, 'production' on the server.
# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# Production: set this to true. Together with Config\Cookie::$secure (which turns
# itself on when CI_ENVIRONMENT = production) it keeps the session and CSRF
# cookies on HTTPS only.
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = webscheduler_directory
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix = xs_
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

# Config\Cookie::$secure defaults to (CI_ENVIRONMENT === 'production'), so you
# normally do not need this. Uncomment only as an escape hatch — e.g. a staging
# host without TLS, or a proxy that terminates HTTPS upstream (in which case also
# populate Config\App::$proxyIPs, or forcehttps will redirect-loop).
# cookie.secure = false

# cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# DIRECTORY (this app)
#--------------------------------------------------------------------

# directory.siteName = 'WebScheduler Directory'

# Where new-submission notifications are sent.
# directory.adminEmail =

# Password for /admin/login. Set a strong value in production.
# directory.adminPassword =

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

# Used for listing verification emails and admin notifications.
#
# These are LIVE (uncommented) on purpose: they point at Mailpit, so a fresh
# clone catches mail locally instead of silently doing nothing. Leaving them
# commented makes email.protocol fall back to PHP mail(), and because send
# failures are swallowed by design (see DirectoryListingMutationService::send)
# the verification email would vanish with no error.
#
# Start Mailpit with `npm run mail:dev`; inbox at http://localhost:8025.
# The production template is separate — dist/listing/directory-app/.env.example,
# generated by `npm run list:build` with CHANGE-ME placeholders.
email.protocol = smtp
email.SMTPHost = localhost
email.SMTPPort = 1025
email.SMTPCrypto =
email.fromEmail = 'no-reply@webscheduler.co.za'
email.fromName = 'WebScheduler Directory'
email.mailType = html

# Production only — real SMTP needs auth and TLS on 587:
# email.SMTPUser =
# email.SMTPPass =
# email.SMTPPort = 587
# email.SMTPCrypto = tls

