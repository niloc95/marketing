#--------------------------------------------------------------------
# WebScheduler Directory — PRODUCTION .env template
# Copy to `.env` on the server and fill in. Never commit the real .env.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://directory.webscheduler.co.za/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

# Generate once with: php spark key:generate  (or set manually)
encryption.key =

#--------------------------------------------------------------------
# DATABASE (from cPanel → MySQL Databases; names are cPanel-prefixed)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = CPUSER_directory
database.default.username = CPUSER_diruser
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix = xs_
database.default.port = 3306

#--------------------------------------------------------------------
# DIRECTORY — shared HMAC handoff secret (MUST equal directory.handoffSecret
# on every WebScheduler app that hands off here). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------
directory.prefillSecret = CHANGE_ME_SAME_ON_BOTH_SYSTEMS
directory.siteName = 'WebScheduler Directory'
directory.adminEmail = 'you@webscheduler.co.za'

# Admin login. Generate the hash with:
#   php spark directory:adminhash
# It prompts for the password and prints the line to paste here, so the
# password itself is never written to disk. Minimum 12 characters.
#
# Do NOT use the older `directory.adminPassword` instead — it stores the
# password in cleartext in this file and takes a deprecated comparison path
# that logs a warning on every login. It remains only so deployments predating
# the hash keep working.
directory.adminPasswordHash = 'CHANGE_ME_RUN_SPARK_DIRECTORY_ADMINHASH'

# Unlocks the detailed body of /health. Without it the endpoint still answers
# 200 (ok) or 503 (degraded) to anyone — which is all an uptime monitor needs —
# but the per-check breakdown naming the broken dependency stays private.
# Generate with: php -r "echo bin2hex(random_bytes(16));"
directory.healthToken = CHANGE_ME_RANDOM_HEX

#--------------------------------------------------------------------
# EMAIL (verification + admin notifications) — your cPanel/SMTP mailbox
#--------------------------------------------------------------------
email.fromEmail = 'no-reply@webscheduler.co.za'
email.fromName = 'WebScheduler Directory'
email.protocol = 'smtp'
email.SMTPHost = 'mail.webscheduler.co.za'
email.SMTPUser = 'no-reply@webscheduler.co.za'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 465
email.SMTPCrypto = 'ssl'
