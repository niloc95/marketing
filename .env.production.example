#--------------------------------------------------------------------
# WebScheduler Directory — PRODUCTION .env template
# Copy to `.env` on the server and fill in. Never commit the real .env.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://listing.webscheduler.co.za/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

# Generate once with: php spark key:generate  (or set manually)
encryption.key =

#--------------------------------------------------------------------
# DATABASE (from cPanel → MySQL Databases; names are cPanel-prefixed)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = CPUSER_directory
database.default.username = CPUSER_diruser
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix = xs_
database.default.port = 3306

#--------------------------------------------------------------------
# DIRECTORY — shared HMAC handoff secret (MUST equal directory.handoffSecret
# on every WebScheduler app that hands off here). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------
directory.prefillSecret = CHANGE_ME_SAME_ON_BOTH_SYSTEMS
directory.siteName = 'WebScheduler Directory'

# Two jobs, so pick a role address rather than a person's inbox: it receives the
# new-listing notifications, AND it is rendered publicly as the contact address
# on the privacy and terms pages (see app/Views/legal/privacy.php). Whatever is
# set here is published on the open web and will be scraped.
directory.adminEmail = 'za_admin@webscheduler.co.za'

# Admin login. Generate the hash with:
#   php spark directory:adminhash
# It prompts for the password and prints the line to paste here, so the
# password itself is never written to disk. Minimum 12 characters.
#
# Do NOT use the older `directory.adminPassword` instead — it stores the
# password in cleartext in this file and takes a deprecated comparison path
# that logs a warning on every login. It remains only so deployments predating
# the hash keep working.
directory.adminPasswordHash = 'CHANGE_ME_RUN_SPARK_DIRECTORY_ADMINHASH'

# Unlocks the detailed body of /health. Without it the endpoint still answers
# 200 (ok) or 503 (degraded) to anyone — which is all an uptime monitor needs —
# but the per-check breakdown naming the broken dependency stays private.
# Generate with: php -r "echo bin2hex(random_bytes(16));"
directory.healthToken = CHANGE_ME_RANDOM_HEX

#--------------------------------------------------------------------
# MAP TILES
#--------------------------------------------------------------------
# CARTO basemap key for the three Leaflet maps — search, profile, and the
# listing form's pin picker. Free: no account, 5M tiles/month, and CARTO's FAQ
# says you need not declare commercial use in advance. Get one at
# https://carto.com/basemaps/apikey
#
# Set it. Leaving it out does not break the maps, which is the problem — every
# tile comes back stamped "API KEY REQUIRED" as a valid HTTP 200 PNG, so there
# is no error, no failed request, no CSP violation and nothing in the logs. A
# wrong key behaves identically to no key.
#
# Verify by looking at a map, not by status code. Do not compare byte sizes
# either: a real tile can be SMALLER than a watermarked one, because the
# watermark is extra pixels on top of the same map.
directory.mapTileKey = CHANGE_ME_CARTO_BASEMAP_KEY

#--------------------------------------------------------------------
# EMAIL (verification + admin notifications) — your cPanel/SMTP mailbox
#--------------------------------------------------------------------
email.fromEmail = 'no-reply@webscheduler.co.za'
email.fromName = 'WebScheduler Directory'
email.protocol = 'smtp'
email.SMTPHost = 'mail.webscheduler.co.za'
email.SMTPUser = 'no-reply@webscheduler.co.za'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 465
email.SMTPCrypto = 'ssl'

# Required. Config\Email::$mailType defaults to 'text', and every template in
# app/Views/emails/ is HTML — including verify.php, the one that publishes a
# listing. Omit this and recipients get raw markup instead of a rendered email.
email.mailType = html

#--------------------------------------------------------------------
# VERIFIED BUSINESS BADGE
#--------------------------------------------------------------------
# The feature itself. On by default: businesses can send documents, you can
# review them in the admin queue, and you can award the badge with "Activate
# manually" for anyone who pays by EFT. None of that needs PayFast.
#
# This and the price below are FALLBACKS. Both are editable from the admin
# panel at /admin/settings, and a value saved there is stored in the database
# and wins over these. That page names which source the live value came from,
# so a stale line here never looks like a bug.
directory.verifiedBadgeEnabled = true

#--------------------------------------------------------------------
# ...and card payments for it (PayFast) — optional
#--------------------------------------------------------------------
# Leaving these blank does NOT hide the feature. It only means no card
# checkout and no self-serve cancel button: an approved business is told
# you will be in touch about payment, and you activate their badge by hand.
#
# The passphrase is optional to PayFast and effectively mandatory here. The
# merchant id and key both travel inside a form the buyer can read; the
# passphrase is the only part of the signature they cannot see. Set the same
# value here and in PayFast → Settings.
#
# THIS FILE IS COMMITTED TO GIT. Never put real values here — they belong in
# .env on the server, which is untracked and excluded from the deploy. Watch
# for stray whitespace inside the quotes too: a tab or space becomes part of
# the value, and the only symptom is every payment failing on a signature
# mismatch with no useful error anywhere.
directory.payfastMerchantId = 'CHANGE_ME'
directory.payfastMerchantKey = 'CHANGE_ME'
directory.payfastPassphrase = 'CHANGE_ME'

# Defaults to true when absent, so a half-configured environment moves no real
# money. The flip side: leaving it true in production means you take NO money
# and nothing errors — the admin Status page warns while it is on.
directory.payfastSandbox = false

# Monthly price, in rand — a fallback, overridden by /admin/settings. Write it
# with a point: '29,99' is how it is said here and how PHP reads it as 29.
# Changing the price affects new applications only; existing subscribers keep
# the amount stored on their verification row, which is what their renewals are
# validated against.
directory.verifiedMonthlyAmount = '29.99'

#--------------------------------------------------------------------
# NEWSLETTER + MAUTIC (updates.webscheduler.co.za)
#--------------------------------------------------------------------
# The footer newsletter posts to the WebScheduler Local form in Mautic — its
# own form, not the marketing site's form 1. Defaults live in
# app/Config/Directory.php (form id 2, alias localnewsletter); override only if
# Mautic gave the form a different id. The CSP form-action host is derived
# from this URL, so a new host needs no CSP edit.
# directory.newsletterFormUrl = 'https://updates.webscheduler.co.za/form/submit?formId=2'
# directory.newsletterFormId = 2
# directory.newsletterFormName = 'localnewsletter'

# Sync of listing owners who ticked the marketing box (spark mautic:sync).
# Leave all four unset to switch the sync off. Use a Mautic user limited to
# contacts and segments, with HTTP basic auth enabled under Mautic's API
# settings. The password is a secret: this file only ever holds placeholders.
directory.mauticBaseUrl = 'https://updates.webscheduler.co.za'
directory.mauticUsername = 'listing-sync'
directory.mauticPassword = 'CHANGE_ME'
directory.mauticOwnerSegmentId = CHANGE_ME_SEGMENT_ID
