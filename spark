use CodeIgniter\Boot;
use Config\Paths;

/*
 * --------------------------------------------------------------------
 * CODEIGNITER COMMAND-LINE TOOLS
 * --------------------------------------------------------------------
 * The main entry point into the CLI system and allows you to run
 * commands and perform maintenance on your application.
 */

/*
 *---------------------------------------------------------------
 * CHECK SERVER API
 *---------------------------------------------------------------
 */

// Refuse to run when called from php-cgi
if (str_starts_with(PHP_SAPI, 'cgi')) {
    exit("The cli tool is not supported when running php-cgi. It needs php-cli to function!\n\n");
}

/*
 *---------------------------------------------------------------
 * CHECK PHP VERSION
 *---------------------------------------------------------------
 */

$minPhpVersion = '8.2'; // If you update this, don't forget to update `public/index.php`.
if (version_compare(PHP_VERSION, $minPhpVersion, '<')) {
    $message = sprintf(
        'Your PHP version must be %s or higher to run CodeIgniter. Current version: %s',
        $minPhpVersion,
        PHP_VERSION,
    );

    exit($message);
}

// We want errors to be shown when using it from the CLI.
error_reporting(E_ALL);
ini_set('display_errors', '1');

/*
 *---------------------------------------------------------------
 * SET THE CURRENT DIRECTORY
 *---------------------------------------------------------------
 */

// Path to the front controller.
//
// Stock CI4 hard-codes __DIR__/public/. That is right for this repo and wrong
// for the deployed layout, where the app sits at directory-app/ with the web
// root beside it as public_html/ — so directory-app/public/ does not exist,
// every spark command printed a chdir() warning, and, far worse, anything
// resolving an upload path against FCPATH looked under a directory that was
// not there.
//
// That is not hypothetical: it cost a release. The hero seeder ran, reported
// success and inserted nothing, because every photo looked missing. The
// workaround lives in DirectoryHeroImagesSeeder::docroot() and had to be
// repeated by any other caller that needed the docroot from the CLI. Fixing it
// here instead means FCPATH is simply correct for every command in both
// layouts, and neither has to know about the other.
//
// Note for a framework upgrade: this file is app-level scaffolding, so composer
// will not overwrite it — but if it is ever regenerated from the CI4 skeleton,
// this block has to come back with it.
$fcpath = __DIR__ . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR;

foreach ([
    $fcpath,
    __DIR__ . DIRECTORY_SEPARATOR . '..' . DIRECTORY_SEPARATOR . 'public_html' . DIRECTORY_SEPARATOR,
] as $candidate) {
    $real = realpath($candidate);
    if ($real !== false && is_dir($real)) {
        $fcpath = rtrim($real, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR;
        break;
    }
}

define('FCPATH', $fcpath);
unset($fcpath, $candidate, $real);

// Guarded, because chdir() into a directory that is not there is precisely the
// warning this block exists to remove. If neither candidate resolved, leave the
// working directory alone rather than shouting about it on every command.
if (is_dir(FCPATH)) {
    chdir(FCPATH);
}

/*
 *---------------------------------------------------------------
 * BOOTSTRAP THE APPLICATION
 *---------------------------------------------------------------
 * This process sets up the path constants, loads and registers
 * our autoloader, along with Composer's, loads our constants
 * and fires up an environment-specific bootstrapping.
 */

// LOAD OUR PATHS CONFIG FILE
// Anchored on __DIR__, not on FCPATH. Stock CI4 writes this as
// FCPATH . '../app/Config/Paths.php', which only works because it assumes
// FCPATH is __DIR__/public/ — the assumption the block above deliberately
// breaks. app/ is a sibling of this file in both layouts, so __DIR__ is both
// simpler and the thing that is actually true.
require __DIR__ . DIRECTORY_SEPARATOR . 'app' . DIRECTORY_SEPARATOR . 'Config' . DIRECTORY_SEPARATOR . 'Paths.php';

$paths = new Paths();

// LOAD THE FRAMEWORK BOOTSTRAP FILE
require $paths->systemDirectory . '/Boot.php';

exit(Boot::bootSpark($paths));
